{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "AgentMail",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Inter"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "icon": "discord",
        "href": "https://discord.gg/hTYatWYWBc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://console.agentmail.to"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/agentmail_to",
      "github": "https://github.com/agentmail-to",
      "discord": "https://discord.gg/hTYatWYWBc"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "quickstart",
              "architecture"
            ]
