{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "AgentMail",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Inter"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "icon": "discord",
        "href": "https://discord.gg/hTYatWYWBc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://console.agentmail.to"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/agentmail_to",
      "github": "https://github.com/agentmail-to",
      "discord": "https://discord.gg/hTYatWYWBc"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "Core tasks",
            "pages": [
              "core/receive",
              "core/send",
              "core/conversations",
              "core/inbound-control",
              "core/imap-smtp"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/webhooks",
              "advanced/websockets",
              "advanced/safety",
              "advanced/custom-domains",
              "advanced/deliverability",
              "advanced/multi-tenant",
              "advanced/agentid",
              "advanced/agentid-browser-enrollment",
              "advanced/errors",
              "advanced/plans-and-usage",
              "advanced/eu-region"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/outbound-gtm-sdr-agent",
              "examples/customer-support-agent",
              "examples/ai-employee-with-its-own-inbox"
            ]
          },
          {
            "group": "Extras",
            "pages": [
              "extras/labels-and-system-labels",
              "extras/deliverability-fundamentals",
              "extras/security-compliance",
              "extras/account-lifecycle"
            ]
          }
        ]
      },
      {
        "tab": "Integrations and SDKs",
        "groups": [
          {
            "group": "Integrations and SDKs",
            "pages": [
              "integrations/sdks-and-cli",
              "integrations/mcp-and-skills",
              {
                "group": "Agent platforms",
                "pages": [
                  "integrations/frameworks/claude-cowork",
                  "integrations/frameworks/claude-code",
                  "integrations/frameworks/codex",
                  "integrations/frameworks/openclaw",
                  "integrations/frameworks/grok",
                  "integrations/frameworks/manus",
                  "integrations/frameworks/cursor",
                  "integrations/frameworks/devin",
                  "integrations/frameworks/opencode",
                  "integrations/frameworks/replit",
                  "integrations/frameworks/sim",
                  "integrations/frameworks/hermes"
