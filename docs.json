                  "integrations/frameworks/codex",
                  "integrations/frameworks/openclaw",
                  "integrations/frameworks/grok",
                  "integrations/frameworks/manus",
                  "integrations/frameworks/cursor",
                  "integrations/frameworks/devin",
                  "integrations/frameworks/opencode",
                  "integrations/frameworks/replit",
                  "integrations/frameworks/sim",
